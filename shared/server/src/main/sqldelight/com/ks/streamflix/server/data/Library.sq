CREATE TABLE library (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    kind TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE library_folder (
    library_id INTEGER NOT NULL REFERENCES library(id) ON DELETE CASCADE,
    path TEXT NOT NULL,
    PRIMARY KEY (library_id, path)
);

insertLibrary:
INSERT INTO library(name, kind, created_at) VALUES (?, ?, ?);

insertFolder:
INSERT OR IGNORE INTO library_folder(library_id, path) VALUES (?, ?);

libraries:
SELECT library.id, library.name, library.kind,
       (SELECT COUNT(*) FROM item WHERE item.library_id = library.id) AS item_count
FROM library ORDER BY name COLLATE NOCASE;

libraryById:
SELECT library.id, library.name, library.kind,
       (SELECT COUNT(*) FROM item WHERE item.library_id = library.id) AS item_count
FROM library WHERE id = ?;

libraryIdByName:
SELECT id FROM library WHERE name = ? COLLATE NOCASE;

folders:
SELECT path FROM library_folder WHERE library_id = ? ORDER BY path;

allFolders:
SELECT path FROM library_folder;
